# Copy to .env and set the dedicated test usernames. `.env` is gitignored.
# Test files pass the matching username to login(page, username).
# CI falls back to its E2E_USERNAME for suites with no suite-specific username.

E2E_BASE_URL=http://localhost:8080

E2E_USERNAME=systems-team-test@ala.org.au
E2E_BIOSECURITY_USERNAME=systems-team-test-b@ala.org.au
E2E_STANDARD_USERNAME=systems-team-test-s@ala.org.au

#AWS SECRET ID
E2E_AWS_SECRET_ID=



