# Copy to .env and fill in. `.env` is gitignored - NEVER commit real credentials.
# Use a dedicated test account, not a personal or production login.

BASE_URL=http://localhost:8080

E2E_USERNAME=alerts-test@example.com

# On macOS you can leave this empty and store the password in the Keychain instead:
#   security add-generic-password -U -s alerts-e2e -a "alerts-e2e@example.org" -w
E2E_PASSWORD=

